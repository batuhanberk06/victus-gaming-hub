<Application x:Class="VictusHub.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="Muted" Color="#9296A6" />
    <SolidColorBrush x:Key="Accent" Color="#A8B4FF" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0F4" /><Setter Property="FontFamily" Value="Segoe UI" /></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EAF0F4" /><Setter Property="Background" Value="#202A36" /><Setter Property="BorderBrush" Value="#354252" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="16,10" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="13" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#6DE3C1" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.45" /><Setter Property="Cursor" Value="Arrow" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#CFD9E2" /><Setter Property="FontSize" Value="13" /><Setter Property="Margin" Value="0,6,0,6" /><Setter Property="Cursor" Value="Hand" /></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#191B22" /><Setter Property="BorderBrush" Value="#292C36" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="14,12" /></Style>
  </Application.Resources>
</Application>
