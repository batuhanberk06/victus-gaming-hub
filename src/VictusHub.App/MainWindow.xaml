<Window x:Class="VictusHub.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Victus Gaming Hub" Icon="Assets/Victus.ico" Width="560" Height="410" MinWidth="520" MinHeight="400" WindowStartupLocation="CenterScreen" Background="#101116" Foreground="#F1F2F6" FontFamily="Segoe UI">
  <Border Background="#101116">
  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/Victus.png" Width="26" Height="26" Margin="0,0,8,0"/><TextBlock Text="Victus Gaming Hub" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
      <TextBlock Grid.Column="1" x:Name="PowerState" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <ToggleButton Grid.Column="2" x:Name="SettingsToggle" FontSize="15" Width="32" Height="30" Background="#191B22" Foreground="#C5C8D4" BorderThickness="0" ToolTip="Settings" Cursor="Hand"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Foreground="#C5C8D4" FontSize="15"/></ToggleButton>
      <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle}" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
        <Border Background="#191B22" BorderBrush="#343744" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,6,0,0" Width="310">
          <StackPanel><TextBlock Text="Settings" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/><CheckBox x:Name="StartupCheck" Content="Start with Windows" Click="Startup_Click"/><CheckBox x:Name="CloseToTrayCheck" Content="Close to system tray" Click="CloseToTray_Click" IsChecked="True"/><Border Height="1" Background="#30333E" Margin="0,12,0,12"/><TextBlock x:Name="DeviceName" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="DeviceDetail" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        </Border>
      </Popup>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="36"/><RowDefinition Height="36"/><RowDefinition Height="12"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <TextBlock Grid.Column="1" Text="Usage" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
        <TextBlock Grid.Column="2" Text="Temp" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
        <TextBlock Grid.Column="3" Text="Power" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="1" Text="CPU" FontSize="13" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CpuValue" Text="—" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="2" x:Name="CpuTemperature" Text="—" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="1" Grid.Column="3" x:Name="CpuPower" Text="—" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Text="GPU" FontSize="13" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="GpuValue" Text="—" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="GpuTemperature" Text="—" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="2" Grid.Column="3" x:Name="GpuPower" Text="—" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <Border Grid.Row="3" Grid.ColumnSpan="4" Height="1" Background="#2C2F3A" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="4" Text="RAM" FontSize="13" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="RamValue" Text="—" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" x:Name="RamDetail" Text="— / — GiB" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,0,0,16">
      <Grid><TextBlock Text="Performance" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="ProfileDetail" Visibility="Collapsed" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" ToolTip="The highlight shows the last applied profile. Firmware does not report the active profile name."/></Grid>
      <UniformGrid Columns="4" Margin="0,10,0,0"><Button x:Name="EcoButton" Content="Eco" Tag="Eco" Click="Profile_Click" IsEnabled="False" Margin="0,0,6,0" Padding="4,9"/><Button x:Name="QuietButton" Content="Quiet" Tag="Quiet" Click="Profile_Click" IsEnabled="False" Margin="0,0,6,0" Padding="4,9"/><Button x:Name="DefaultButton" Content="Default" Tag="Default" Click="Profile_Click" IsEnabled="False" Margin="0,0,6,0" Padding="4,9"/><Button x:Name="PerformanceButton" Content="Performance" Tag="Performance" Click="Profile_Click" IsEnabled="False" Padding="4,9"/></UniformGrid>
    </StackPanel>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Orientation="Horizontal"><TextBlock Text="Fan" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="FanDetail" Visibility="Collapsed" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,1,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="AutoButton" Content="Auto" Tag="Auto" Click="Fan_Click" IsEnabled="False" Width="72" Padding="4,8" Margin="0,0,6,0"/><Button x:Name="MaxButton" Content="Max" Tag="Max" Click="Fan_Click" IsEnabled="False" Width="72" Padding="4,8"/></StackPanel></Grid>
  </Grid>
  </Border>
</Window>






